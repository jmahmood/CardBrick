    {
      "pattern_id": "P003", "kind": "mcq", "variant": 1,
      "tier": "core", "gate": "A0", "priority_score": 0.99,
      "template": "[S] ser de [Loc]",
      "tags": "topic:smalltalk",
      "cue_en": "Say that you are from Canada. Which is correct?",
      "options": [
        {"text": "Soy de Canadá.", "correct": true},
        {"text": "Soy en Canadá.", "correct": false},
        {"text": "Estoy de Canadá.", "correct": false}
      ],
      "constraint_note": "Origin is ser + de: where you're FROM is ser, where you ARE right now is estar en."
