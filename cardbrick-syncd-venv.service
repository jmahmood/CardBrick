[Unit]
Description=CardBrick Sync Daemon (Virtual Environment)
After=network.target
Wants=network.target

[Service]
Type=simple
User=jawaad
Group=jawaad
WorkingDirectory=/home/jawaad/CardBrick/cardbrick-syncd
Environment=CARDBRICK_DATA_DIR=/var/lib/cardbrick
Environment=PYTHONPATH=/home/jawaad/CardBrick/cardbrick-syncd:/home/jawaad/CardBrick/cardbrick-cli
ExecStart=/home/jawaad/CardBrick/venv-syncd/bin/python -m main
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cardbrick

[Install]
WantedBy=multi-user.target
